# ==============================
# Application
# ==============================

APP_ENV=development


# ==============================
# PostgreSQL
# ==============================

POSTGRES_DB=commerce
CHECKPOINT_POSTGRES_DB=commerce_checkpoint

POSTGRES_USER=commerce
POSTGRES_PASSWORD=change_me


# Host-side URLs
# Used when running Python directly on the host.

DATABASE_URL=postgresql+psycopg://commerce:change_me@localhost:5432/commerce

CHECKPOINT_DATABASE_URL=postgresql://commerce:change_me@localhost:5433/commerce_checkpoint


# ==============================
# LLM
# ==============================

DEEPSEEK_API_KEY=your_api_key
DEEPSEEK_BASE_URL=your_provider_base_url
DEEPSEEK_MODEL=your_model_name


# ==============================
# Langfuse
# ==============================

LANGFUSE_TRACING_ENABLED=false

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development


# ==============================
# LangGraph
# ==============================

LANGGRAPH_STRICT_MSGPACK=true